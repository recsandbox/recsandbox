<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>RecSandbox – Hang out, play, build together</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@600;800&family=Nunito:wght@400;600;800&display=swap" rel="stylesheet">
<style>
:root{
  --orange:#ff6a1a; --orange-hi:#ff8a4d; --amber:#f0a040; --coral:#ff7f45;
  --bg:#fff8f1; --card:#fff; --ink:#2a1d14; --muted:#7a6a5d; --line:#f1dfd0; --tint:#fff1e6;
  --display:'Baloo 2','Trebuchet MS',system-ui,sans-serif; --body:'Nunito',system-ui,sans-serif;
  box-sizing:border-box; padding-top:env(safe-area-inset-top,0px); padding-bottom:env(safe-area-inset-bottom,0px);
}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#1c1410;--card:#2a1f18;--ink:#fbeee2;--muted:#b9a494;--line:#3f2f24;--tint:#3a281b}}
:root[data-theme="dark"]{--bg:#1c1410;--card:#2a1f18;--ink:#fbeee2;--muted:#b9a494;--line:#3f2f24;--tint:#3a281b}
html{scroll-padding-top:env(safe-area-inset-top,0px);scroll-behavior:smooth}
*,*::before,*::after{box-sizing:inherit}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--body);line-height:1.55}
a{color:inherit}
:focus-visible{outline:3px solid var(--ink);outline-offset:3px;border-radius:8px}
h1,h2,h3{font-family:var(--display);line-height:1.05;margin:0}
.wrap{max-width:1120px;margin:0 auto;padding:0 20px}

/* buttons */
.btn{font:800 1rem var(--display);border:0;border-radius:14px;padding:12px 22px;cursor:pointer;text-decoration:none;display:inline-block;transition:transform .12s,background .12s}
.btn:active{transform:scale(.97)}
.btn-primary{background:var(--orange);color:#fff}
.btn-primary:hover{background:var(--orange-hi)}
.btn-ghost{background:var(--card);color:var(--orange);box-shadow:inset 0 0 0 2px rgba(255,106,26,.5)}
.btn-ghost:hover{background:var(--tint)}
.btn-lg{font-size:1.25rem;padding:16px 30px}

/* nav */
nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:10;background:var(--card);border-bottom:1px solid var(--line)}
nav .wrap{display:flex;align-items:center;gap:22px;height:64px}
.logo{font:800 1.6rem var(--display);color:var(--orange);text-decoration:none;display:flex;align-items:center;gap:8px}
.logo i{width:26px;height:26px;border:4px solid var(--orange);border-radius:8px;position:relative;display:inline-block}
.logo i::before,.logo i::after{content:"";position:absolute;top:4px;width:3px;height:5px;background:var(--orange)}
.logo i::before{left:4px}.logo i::after{right:4px}
nav .links{display:flex;gap:18px;margin-left:8px}
nav .links a{text-decoration:none;font-weight:800;color:var(--muted)}
nav .links a:hover{color:var(--orange)}
nav .sp{flex:1}
#navUser{font-weight:800;display:flex;align-items:center;gap:8px}
.dot{width:26px;height:26px;border-radius:50%;display:inline-block}

/* hero */
.hero{position:relative;overflow:hidden;background:linear-gradient(105deg,var(--amber),var(--coral));color:#fff}
.hero::before{content:"";position:absolute;inset:-40%;transform:rotate(-8deg);opacity:.5;pointer-events:none;
  background-image:
   radial-gradient(circle at 32% 25%,#fff 0 3px,transparent 4px),radial-gradient(circle at 68% 25%,#fff 0 3px,transparent 4px),
   radial-gradient(circle at 50% 55%,transparent 0 9px,#fff 10px 12px,transparent 13px),
   linear-gradient(#fff 0 0);
  background-size:112px 112px;-webkit-mask:none}
.hero::after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,rgba(240,160,64,.94),rgba(255,127,69,.9));pointer-events:none}
.hero .wrap{position:relative;z-index:1;display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;padding-top:56px;padding-bottom:64px}
.hero h1{font-size:clamp(2.6rem,6vw,4.6rem);font-weight:800;letter-spacing:-.01em;text-shadow:0 3px 0 rgba(150,60,0,.25)}
.hero p{font-size:1.2rem;max-width:34ch;margin:18px 0 26px;font-weight:600}
.hero .cta{display:flex;flex-wrap:wrap;gap:12px}
.hero .btn-primary{background:#fff;color:var(--orange)}
.hero .btn-primary:hover{background:var(--tint)}
.hero .btn-ghost{background:transparent;color:#fff;box-shadow:inset 0 0 0 2px #fff}
.hero .btn-ghost:hover{background:rgba(255,255,255,.18)}
.silhouette{position:absolute;left:-30px;bottom:-40px;width:230px;opacity:.16;z-index:0}

/* auth panel */
.panel{background:var(--card);color:var(--ink);border-radius:24px;padding:28px;box-shadow:0 18px 40px rgba(120,40,0,.28);max-width:400px;justify-self:end;width:100%}
.panel h2{font-size:1.9rem;color:var(--orange);text-align:center}
.panel .sub{text-align:center;color:var(--muted);margin:4px 0 16px;font-weight:600}
.panel input{width:100%;font:600 1rem var(--body);padding:11px 14px;margin-bottom:10px;border:2px solid var(--line);border-radius:12px;background:var(--bg);color:var(--ink)}
.panel input:focus{border-color:var(--orange);outline:none}
.panel .btn{width:100%;margin-top:4px}
.panel .err{color:#d93025;min-height:1.3em;font-weight:700;font-size:.92rem;text-align:center;margin:0 0 4px}
.panel .toggle{display:block;margin:10px auto 0;background:none;border:0;color:var(--orange);font:800 .95rem var(--body);cursor:pointer}
.panel .who{display:flex;flex-direction:column;align-items:center;gap:8px;margin-bottom:14px}
.panel .who .dot{width:72px;height:72px}
.hidden{display:none!important}

/* sections */
section.block{padding:64px 0 8px}
.head{display:flex;flex-wrap:wrap;align-items:end;justify-content:space-between;gap:14px;margin-bottom:22px}
.head h2{font-size:2.3rem;font-weight:800}
.head p{margin:6px 0 0;color:var(--muted);font-weight:600}
.tools{display:flex;flex-wrap:wrap;gap:8px}
.chip{font:800 .9rem var(--body);padding:8px 16px;border-radius:99px;border:2px solid var(--line);background:var(--card);color:var(--ink);cursor:pointer}
.chip[aria-pressed="true"]{background:var(--orange);border-color:var(--orange);color:#fff}
#q{font:600 .95rem var(--body);padding:8px 16px;border-radius:99px;border:2px solid var(--line);background:var(--card);color:var(--ink);width:180px}

.rooms{display:grid;grid-template-columns:repeat(auto-fill,minmax(240px,1fr));gap:18px}
.room{background:var(--card);border-radius:20px;overflow:hidden;border:1px solid var(--line);display:flex;flex-direction:column;text-align:left;cursor:pointer;font:inherit;color:inherit;padding:0;transition:transform .15s,box-shadow .15s}
.room:hover{transform:translateY(-4px);box-shadow:0 12px 26px rgba(120,40,0,.16)}
.thumb{height:130px;position:relative;display:grid;place-items:center}
.thumb .face{width:54px;height:54px;border:5px solid rgba(255,255,255,.85);border-radius:16px;position:relative}
.thumb .face::before,.thumb .face::after{content:"";position:absolute;top:11px;width:5px;height:11px;background:rgba(255,255,255,.85);border-radius:3px}
.thumb .face::before{left:11px}.thumb .face::after{right:11px}
.thumb .face b{position:absolute;left:13px;right:13px;bottom:8px;height:8px;border-bottom:5px solid rgba(255,255,255,.85);border-radius:0 0 12px 12px}
.badge{position:absolute;top:10px;left:10px;background:rgba(0,0,0,.35);color:#fff;font-weight:800;font-size:.78rem;padding:3px 10px;border-radius:99px}
.room .info{padding:14px 16px 16px}
.room h3{font-size:1.25rem;font-weight:800}
.room .by{color:var(--muted);font-size:.9rem;font-weight:600}
.room .meta{display:flex;justify-content:space-between;margin-top:10px;font-weight:800;font-size:.9rem}
.live{color:#1a9a55}
.empty{grid-column:1/-1;padding:30px;text-align:center;color:var(--muted);font-weight:700;background:var(--card);border-radius:20px;border:2px dashed var(--line)}

.events{display:grid;gap:12px}
.event{display:grid;grid-template-columns:76px 1fr auto;gap:16px;align-items:center;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:14px 18px}
.date{background:var(--tint);border-radius:14px;text-align:center;padding:8px 0;font-family:var(--display);font-weight:800;color:var(--orange);line-height:1}
.date span{display:block;font-size:1.9rem}.date small{font-size:.85rem}
.event h3{font-size:1.2rem}.event p{margin:2px 0 0;color:var(--muted);font-weight:600;font-size:.95rem}

.dl{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:16px}
.dl div{background:var(--card);border:1px solid var(--line);border-radius:20px;padding:22px;display:flex;flex-direction:column;gap:8px}
.dl h3{font-size:1.4rem}.dl p{margin:0 0 8px;color:var(--muted);font-weight:600;flex:1}

footer{margin-top:70px;background:var(--card);border-top:1px solid var(--line);padding:26px 0;color:var(--muted);font-weight:600}
footer .wrap{display:flex;flex-wrap:wrap;gap:16px;justify-content:space-between;align-items:center}
#toast{position:fixed;left:50%;bottom:calc(24px + env(safe-area-inset-bottom,0px));transform:translate(-50%,30px);background:var(--ink);color:var(--bg);padding:12px 20px;border-radius:14px;font-weight:800;opacity:0;pointer-events:none;transition:.25s;z-index:30;max-width:90vw;text-align:center}
#toast.on{opacity:1;transform:translate(-50%,0)}

@media (max-width:820px){
  .hero .wrap{grid-template-columns:1fr;padding-top:36px}
  .panel{justify-self:stretch;max-width:none}
  nav .links{display:none}
  .event{grid-template-columns:64px 1fr}.event .btn{grid-column:1/-1}
}
@media (prefers-reduced-motion:reduce){*{transition:none!important;scroll-behavior:auto!important}}
#phone{position:fixed;inset:0;z-index:100;background:#ff7f45;display:none}
#phone.on{display:block}
#phone iframe{width:100%;height:100%;border:0;display:block}
#phoneClose{position:absolute;top:calc(10px + env(safe-area-inset-top,0px));right:12px;z-index:2;font:800 .9rem var(--body);padding:8px 14px;border-radius:99px;border:1px solid rgba(255,255,255,.6);background:rgba(0,0,0,.45);color:#fff;cursor:pointer}
.dot.big{width:48px;height:48px;position:relative;flex:none}
.dot.xl{width:96px;height:96px}
.st{position:absolute;right:-2px;bottom:-2px;width:14px;height:14px;border-radius:50%;background:#aaa;border:3px solid var(--card)}
.st.on{background:#1fbf6b}
.people{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:14px}
.person{display:flex;align-items:center;gap:12px;background:var(--card);border:1px solid var(--line);border-radius:18px;padding:14px;text-align:left;font:inherit;color:inherit;cursor:pointer}
.person:hover{border-color:var(--orange)}
.person b{display:block;font-family:var(--display);font-size:1.15rem}
.person small{color:var(--muted);font-weight:700}
dialog#prof{border:0;border-radius:24px;padding:0;background:var(--card);color:var(--ink);width:min(380px,92vw)}
dialog#prof::backdrop{background:rgba(0,0,0,.5)}
.pbody{padding:28px;display:flex;flex-direction:column;align-items:center;gap:8px;text-align:center}
.pbody h3{font-size:1.8rem}.pst{margin:0;font-weight:800;color:var(--muted)}.pst.live{color:#1fbf6b}
.bio{margin:4px 0;color:var(--muted);font-weight:600}.since{margin:0;font-size:.85rem;color:var(--muted)}
.pbody textarea{width:100%;min-height:80px;font:600 1rem var(--body);padding:10px;border:2px solid var(--line);border-radius:12px;background:var(--bg);color:var(--ink)}
.pbody .btn{width:100%}
.hero .panel .btn-primary{background:var(--orange);color:#fff}
.hero .panel .btn-primary:hover{background:var(--orange-hi)}
.hero .panel .btn-ghost{background:var(--card);color:var(--orange);box-shadow:inset 0 0 0 2px rgba(255,106,26,.5)}
.hero .panel .btn-ghost:hover{background:var(--tint)}
</style>
</head>
<body>

<nav>
  <div class="wrap">
    <a class="logo" href="#top"><i></i>RecSandbox</a>
    <div class="links"><a href="#rooms">Rooms</a><a href="#people">People</a><a href="#events">Events</a><a href="#play">Play</a></div>
    <div class="sp"></div>
    <div id="navUser"><a class="btn btn-primary" href="#top" id="navJoin" style="padding:8px 18px">Sign up free</a></div>
  </div>
</nav>

<header class="hero" id="top">
  <svg class="silhouette" viewBox="0 0 240 420" aria-hidden="true"><circle cx="120" cy="90" r="70" fill="#000"/><circle cx="48" cy="95" r="12" fill="#000"/><rect x="35" y="170" width="170" height="250" rx="70" fill="#000"/></svg>
  <div class="wrap">
    <div>
      <h1>Hang out in rooms made by players.</h1>
      <p>Jump into a dorm, throw a few punches at the dummy, or build a room of your own. Flat screen or VR.</p>
      <div class="cta">
        <a class="btn btn-primary btn-lg" href="#play">Play now</a>
        <a class="btn btn-ghost btn-lg" href="#rooms">Browse rooms</a>
      </div>
    </div>

    <div class="panel" id="panel">
      <h2>RecSandbox</h2>
      <div id="authView">
        <p class="sub" id="authHeading">Create your account</p>
        <input id="u" placeholder="Username" maxlength="16" autocomplete="username" aria-label="Username">
        <input id="p" type="password" placeholder="Password" autocomplete="current-password" aria-label="Password">
        <input id="p2" type="password" placeholder="Confirm password" autocomplete="new-password" aria-label="Confirm password">
        <p class="err" id="err" role="alert"></p>
        <button class="btn btn-primary" id="go">Create account</button>
        <button class="toggle" id="toggle">I already have an account</button>
      </div>
      <div id="homeView" class="hidden">
        <div class="who"><span class="dot" id="bigDot"></span><div class="sub" style="margin:0" id="who"></div></div>
        <a class="btn btn-primary btn-lg" href="#play" style="width:100%;text-align:center">Play</a>
        <button class="btn btn-ghost" id="myProf" style="margin-top:10px">My profile</button>
        <button class="btn btn-ghost" id="switch" style="margin-top:10px">Log out</button>
      </div>
    </div>
  </div>
</header>

<main class="wrap">
  <section class="block" id="rooms">
    <div class="head">
      <div><h2>Rooms</h2><p>Sample rooms. Swap in your own from the list at the top of the page script.</p></div>
      <div class="tools" id="filters" role="group" aria-label="Filter rooms"></div>
      <input id="q" type="search" placeholder="Search rooms" aria-label="Search rooms">
    </div>
    <div class="rooms" id="roomGrid"></div>
  </section>

  <section class="block" id="people">
    <div class="head"><div><h2>People</h2><p id="peopleStat">Loading...</p></div></div>
    <div class="people" id="peopleGrid"></div>
  </section>

  <section class="block" id="events">
    <div class="head"><div><h2>Events</h2><p>Meet up with other players.</p></div></div>
    <div class="events" id="eventList"></div>
  </section>

  <section class="block" id="play">
    <div class="head"><div><h2>Play RecSandbox</h2><p>Pick how you want to jump in.</p></div></div>
    <div class="dl">
      <div><h3>Desktop</h3><p>Full game with room finding on your local network. This is the project folder: unzip it and open it in Godot 4.3.</p><button class="btn btn-primary" id="dlDesktop">Download RecSandbox.zip</button></div>
      <div><h3>iPhone</h3><p>Plays right in Safari with touch controls. Tap Share, then Add to Home Screen to play full screen.</p><button class="btn btn-primary" id="playPhone">Play on iPhone</button></div>
      <div><h3>VR headset</h3><p>Open this page in your headset's browser (like Meta Quest Browser), then tap Enter VR.</p><button class="btn btn-primary" id="playVR">Play in VR</button></div>
      <div><h3>In your browser</h3><p>Solo only for now. Multiplayer needs the desktop version.</p><button class="btn btn-ghost" data-dl="Browser">Play in browser</button></div>
    </div>
  </section>
</main>

<footer>
  <div class="wrap"><span>© 2026 RecSandbox</span><span>Accounts and profiles are stored online.</span></div>
</footer>
<div id="phone" role="dialog" aria-label="RecSandbox game"><button id="phoneClose">Back to site</button></div>
<dialog id="prof"></dialog>
<div id="toast" role="status"></div>

<script>
/* ---- Edit these to match your game ---- */
const ROOMS=[
 {n:"The Dorm",by:"RecSandbox",tag:"Social",hue:24,feat:true,badge:"Starter"},
 {n:"Punching Dummy Gym",by:"Sparks",tag:"Games",hue:8,feat:true},
 {n:"Skylight Lounge",by:"Mika_B",tag:"Social",hue:42,feat:true},
 {n:"Stripe Rug Arena",by:"Otto",tag:"Games",hue:340,badge:"New"},
 {n:"Poster Wall Gallery",by:"Junie",tag:"Creative",hue:280},
 {n:"Bunk Bed Escape",by:"Dax_7",tag:"Quests",hue:200},
 {n:"Wardrobe Mirror Studio",by:"Pixel_Pia",tag:"Creative",hue:320},
 {n:"Wall Screen Cinema",by:"Nova",tag:"Social",hue:160}
];
const EVENTS=[
 {d:"03",m:"Oct",t:"Dorm meetup",p:"Say hi in The Dorm. New players welcome.",room:"The Dorm"},
 {d:"07",m:"Oct",t:"Dummy punch-off",p:"Highest score wins a spot on the leaderboard.",room:"Punching Dummy Gym"},
 {d:"14",m:"Oct",t:"Room builders night",p:"Show what you're building and swap ideas.",room:"Poster Wall Gallery"}
];
const TAGS=["All","Social","Games","Creative","Quests"];

/* ---- helpers ---- */
const $=id=>document.getElementById(id);
let tagNow="All";
function toast(m){const t=$("toast");t.textContent=m;t.classList.add("on");clearTimeout(toast.h);toast.h=setTimeout(()=>t.classList.remove("on"),2600)}
function esc(s){return String(s).replace(/[&<>"']/g,c=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]))}

/* ---- rooms ---- */
$("filters").innerHTML=TAGS.map(t=>`<button class="chip" aria-pressed="${t==="All"}" data-tag="${t}">${t}</button>`).join("");
$("filters").addEventListener("click",e=>{const b=e.target.closest("[data-tag]");if(!b)return;tagNow=b.dataset.tag;
  document.querySelectorAll(".chip").forEach(c=>c.setAttribute("aria-pressed",c===b));drawRooms()});
$("q").addEventListener("input",drawRooms);
function drawRooms(){
  const q=$("q").value.trim().toLowerCase();
  const list=ROOMS.filter(r=>(tagNow==="All"||r.tag===tagNow)&&(r.n+r.by).toLowerCase().includes(q));
  $("roomGrid").innerHTML=list.length?list.map(r=>`
   <button class="room" data-room="${esc(r.n)}">
     <div class="thumb" style="background:linear-gradient(135deg,hsl(${r.hue} 85% 62%),hsl(${r.hue+25} 80% 48%))">
       ${r.badge?`<span class="badge">${esc(r.badge)}</span>`:""}<div class="face"><b></b></div></div>
     <div class="info"><h3>${esc(r.n)}</h3><div class="by">by ${esc(r.by)}</div>
     <div class="meta"><span>${esc(r.tag)}</span><span class="live">${r.feat?"★ Featured":""}</span></div></div>
   </button>`).join(""):`<div class="empty">No rooms match. Try a different filter or search.</div>`;
}
$("roomGrid").addEventListener("click",e=>{const b=e.target.closest("[data-room]");if(b)joinRoom(b.dataset.room)});
function joinRoom(name){
  if(!current()){toast("Create an account to join "+name);$("top").scrollIntoView();$("u").focus();return}
  toast("Joining "+name+"... open the game to play")
}
drawRooms();

/* ---- events ---- */
$("eventList").innerHTML=EVENTS.map(e=>`
  <div class="event"><div class="date"><span>${e.d}</span><small>${e.m}</small></div>
  <div><h3>${esc(e.t)}</h3><p>${esc(e.p)}</p></div>
  <button class="btn btn-ghost" data-room="${esc(e.room)}">Join room</button></div>`).join("");
$("eventList").addEventListener("click",e=>{const b=e.target.closest("[data-room]");if(b)joinRoom(b.dataset.room)});

const ZIP_B64="";
$("dlDesktop").addEventListener("click",async()=>{
  try{
    const bin=atob(ZIP_B64),arr=new Uint8Array(bin.length);
    for(let i=0;i<bin.length;i++)arr[i]=bin.charCodeAt(i);
    const url=URL.createObjectURL(new Blob([arr],{type:"application/zip"}));
    const a=document.createElement("a");a.href=url;a.download="RecSandbox.zip";document.body.appendChild(a);a.click();a.remove();
    setTimeout(()=>URL.revokeObjectURL(url),4000);
    toast("Downloading RecSandbox.zip");
  }catch(e){if(!e||e.code!=="declined")toast("Couldn't save the file. Try again.")}
});
document.querySelectorAll("[data-dl]").forEach(b=>b.addEventListener("click",()=>toast("Add your "+b.dataset.dl+" build link to this button.")));

/* ---- Real accounts, profiles and online status (Firebase) ---- */
/* Paste the keys from your Firebase project here (see setup steps). */
const FIREBASE_CONFIG={apiKey:"AIzaSyBXq5aMgcLDoEx6RfAO0DPAAmMyHVhIzWk",authDomain:"recsandbox.firebaseapp.com",projectId:"recsandbox",appId:"1:1020694696570:web:8b752d5a56b352c671e1c3"};
const CONFIGURED=!!FIREBASE_CONFIG.apiKey;
const ONLINE_MS=150000;
let dbMsg="",initError="",auth=null,db=null,me=null,profiles=[],creating=true,beat=null;
const EMAIL=n=>n.toLowerCase()+"@recsandbox.app";
const current=()=>me;
const isOn=p=>p.lastSeen?Date.now()-p.lastSeen.toMillis()<ONLINE_MS:!!(me&&p.id===me.id);
function ago(ms){const m=Math.floor(ms/60000);if(m<1)return"just now";if(m<60)return m+"m ago";const h=Math.floor(m/60);return h<24?h+"h ago":Math.floor(h/24)+"d ago"}
function loadScript(src){return new Promise((ok,no)=>{const s=document.createElement("script");s.src=src;s.onload=ok;s.onerror=()=>no(new Error("Couldn't load "+src.split("/").pop()));document.head.appendChild(s)})}

function ping(){if(me&&db&&!document.hidden)db.collection("profiles").doc(me.id).set({lastSeen:firebase.firestore.FieldValue.serverTimestamp()},{merge:true}).catch(()=>{})}
function stopBeat(){clearInterval(beat)}
function startBeat(){stopBeat();ping();beat=setInterval(ping,60000)}
document.addEventListener("visibilitychange",()=>{if(!document.hidden)ping()});

function listen(n){
  db.collection("profiles").orderBy("lastSeen","desc").limit(60).onSnapshot(
    s=>{dbMsg="";profiles=s.docs.map(d=>({id:d.id,...d.data()}));drawPeople()},
    e=>{dbMsg=dbText(e);drawPeople();setTimeout(()=>listen(n+1),Math.min(3000*(n+1),15000))});
}
async function initFirebase(){
  if(!CONFIGURED){$("err").textContent="Setup needed: add your Firebase keys to the page script.";$("go").disabled=true;drawPeople();return}
  try{
    const bases=["https://www.gstatic.com/firebasejs/10.12.2/","https://cdn.jsdelivr.net/npm/firebase@10.12.2/"];
    let lastErr=null;
    for(const base of bases){
      try{for(const f of ["firebase-app-compat.js","firebase-auth-compat.js","firebase-firestore-compat.js"])await loadScript(base+f);lastErr=null;break}
      catch(e){lastErr=e}
    }
    if(lastErr)throw lastErr;
    firebase.initializeApp(FIREBASE_CONFIG);auth=firebase.auth();db=firebase.firestore();try{db.settings({experimentalAutoDetectLongPolling:true,merge:true})}catch(e){}
    auth.onAuthStateChanged(onAuth);
    listen(0);
  }catch(e){initError="Couldn't load Firebase ("+((e&&e.message)||"blocked or offline")+"). Try another browser, turn off ad blockers, and open the site from your hosted link.";$("err").textContent=initError;$("peopleStat").textContent="Couldn't connect.";console.error(e)}
}
const withTimeout=(p,ms)=>Promise.race([p,new Promise((_,no)=>setTimeout(()=>no({code:"unavailable"}),ms))]);
const dbText=e=>AUTH_ERR[e&&e.code]||("Database problem ("+((e&&(e.code||e.message))||"unknown")+").");
async function onAuth(user){
  stopBeat();
  if(!user){me=null;drawUser();return}
  /* show the signed-in state right away, then load the profile */
  me={id:user.uid,name:(user.email||"player@").split("@")[0],color:"hsl(24,65%,62%)",bio:""};
  drawUser();
  if(signingUp)return;
  let snap=null;
  try{snap=await withTimeout(db.collection("profiles").doc(user.uid).get(),8000)}
  catch(e){dbMsg=dbText(e);drawPeople();setTimeout(()=>{if(me&&me.id===user.uid&&auth.currentUser)onAuth(auth.currentUser)},4000);return}
  if(!me||me.id!==user.uid)return;
  if(snap.exists){
    const d=snap.data();
    if(!d.name||!d.color){
      const ts0=firebase.firestore.FieldValue.serverTimestamp();
      const fix={name:d.name||me.name,color:d.color||`hsl(${Math.floor(Math.random()*360)},65%,62%)`,bio:d.bio||"",created:d.created||ts0};
      try{await withTimeout(db.collection("profiles").doc(user.uid).set(fix,{merge:true}),8000)}
      catch(e){dbMsg=dbText(e);drawPeople();return}
      me={id:user.uid,...d,...fix};
    }else me={id:user.uid,...d};
    drawUser();startBeat();return
  }
  const color=`hsl(${Math.floor(Math.random()*360)},65%,62%)`,ts=firebase.firestore.FieldValue.serverTimestamp();
  try{await withTimeout(db.collection("profiles").doc(user.uid).set({name:me.name,color,bio:"",lastSeen:ts,created:ts}),8000);me={...me,color};drawUser();startBeat()}
  catch(e){dbMsg=dbText(e);drawPeople()}
}

/* ---- People ---- */
function drawPeople(){
  const grid=$("peopleGrid"),st=$("peopleStat");
  if(!CONFIGURED){st.textContent="Not connected to a server yet.";grid.innerHTML='<div class="empty">Real players will show up here once the site is connected.</div>';return}
  if(!db)return;
  if(dbMsg&&!profiles.length){st.textContent="Can't load players.";grid.innerHTML='<div class="empty">'+esc(dbMsg)+'</div>';return}
  st.textContent=profiles.filter(isOn).length+" online now · "+profiles.length+" members";
  grid.innerHTML=profiles.length?profiles.map(p=>`<button class="person" data-uid="${esc(p.id)}"><span class="dot big" style="background:${esc(p.color||"hsl(24,65%,62%)")}"><i class="st ${isOn(p)?"on":""}"></i></span><span><b>${esc(p.name||"player")}</b><small>${isOn(p)?"Online now":p.lastSeen?"Seen "+ago(Date.now()-p.lastSeen.toMillis()):"New"}</small></span></button>`).join(""):'<div class="empty">No one has joined yet. Be the first!</div>';
}
setInterval(drawPeople,15000);
$("peopleGrid").addEventListener("click",e=>{const b=e.target.closest("[data-uid]");if(b)openProfile(b.dataset.uid)});
function openProfile(id){
  const p=profiles.find(x=>x.id===id)||(me&&me.id===id?me:null);if(!p)return;
  const mine=me&&me.id===id,d=$("prof"),on=isOn(p);
  d.innerHTML=`<div class="pbody"><span class="dot xl" style="background:${esc(p.color||"hsl(24,65%,62%)")}"></span><h3>${esc(p.name||"player")}</h3>
   <p class="pst ${on?"live":""}">${on?"● Online now":p.lastSeen?"Last seen "+ago(Date.now()-p.lastSeen.toMillis()):"Offline"}</p>
   ${mine?`<textarea id="bioIn" maxlength="200" placeholder="Write something about yourself" aria-label="Your bio">${esc(p.bio||"")}</textarea><button class="btn btn-primary" id="bioSave">Save bio</button>`:`<p class="bio">${esc(p.bio||"No bio yet.")}</p>`}
   <p class="since">Member since ${p.created?p.created.toDate().toLocaleDateString():"today"}</p><button class="btn btn-ghost" id="pClose">Close</button></div>`;
  d.showModal();
  $("pClose").onclick=()=>d.close();
  if(mine)$("bioSave").onclick=async()=>{try{const bio=$("bioIn").value.trim().slice(0,200);await db.collection("profiles").doc(id).set({bio},{merge:true});me.bio=bio;toast("Saved");d.close()}catch(e){toast("Couldn't save. Try again.")}};
}

/* ---- Sign up / log in ---- */
function drawAuth(){
  $("authHeading").textContent=creating?"Create your account":"Log in";
  $("go").textContent=creating?"Create account":"Log in";
  $("toggle").textContent=creating?"I already have an account":"Create a new account";
  $("p2").classList.toggle("hidden",!creating);
  $("err").textContent="";
}
function drawUser(){
  $("authView").classList.toggle("hidden",!!me);
  $("homeView").classList.toggle("hidden",!me);
  if(me){
    $("who").textContent="Signed in as "+me.name;$("bigDot").style.background=me.color;
    $("navUser").innerHTML=`<span class="dot" style="background:${esc(me.color)}"></span>${esc(me.name)}`;$("navUser").style.cursor="pointer";
  }else{
    $("navUser").innerHTML=`<a class="btn btn-primary" href="#top" style="padding:8px 18px">Sign up free</a>`;$("navUser").style.cursor="";drawAuth();
  }
}
$("navUser").addEventListener("click",e=>{if(me&&!e.target.closest("a"))openProfile(me.id)});
$("myProf").onclick=()=>openProfile(me.id);
$("toggle").onclick=()=>{creating=!creating;drawAuth()};
$("switch").onclick=()=>{if(auth)auth.signOut()};
const AUTH_ERR={"auth/email-already-in-use":"That username is taken.","auth/invalid-credential":"Wrong username or password.","auth/user-not-found":"Wrong username or password.","auth/wrong-password":"Wrong username or password.","auth/weak-password":"Password must be at least 6 characters.","auth/too-many-requests":"Too many tries. Wait a bit and try again.","auth/operation-not-allowed":"Email/password sign-in isn't turned on in Firebase yet.","auth/unauthorized-domain":"Add this site's address to Authorized domains in Firebase.","auth/network-request-failed":"Network problem. Check your connection and try again.","auth/invalid-api-key":"The Firebase API key in the page is wrong.","permission-denied":"The database rules aren't published yet. Paste firestore.rules into Firestore > Rules and click Publish.","not-found":"Create the Firestore Database in Firebase first (Build > Firestore Database > Create database).","unavailable":"Connecting to the database... this can take a few seconds. If it stays here, check that Firestore is created."};
let signingUp=false;
async function submit(){
  const name=$("u").value.trim(),pw=$("p").value,err=m=>{$("err").textContent=m};
  if(!auth)return err(initError||"Still connecting... try again in a few seconds.");
  if(name.length<3||name.length>16)return err("Username must be 3-16 characters.");
  if(!/^[A-Za-z0-9_]+$/.test(name))return err("Use letters, numbers and underscores only.");
  if(pw.length<6)return err("Password must be at least 6 characters.");
  if(creating&&pw!==$("p2").value)return err("Passwords don't match.");
  $("go").disabled=true;err("");
  try{
    if(creating){
      signingUp=true;
      const cred=await auth.createUserWithEmailAndPassword(EMAIL(name),pw);
      const color=`hsl(${Math.floor(Math.random()*360)},65%,62%)`,ts=firebase.firestore.FieldValue.serverTimestamp();
      try{await db.collection("profiles").doc(cred.user.uid).set({name,color,bio:"",lastSeen:ts,created:ts})}
      catch(pe){await cred.user.delete().catch(()=>{});throw pe}
      me={id:cred.user.uid,name,color,bio:""};drawUser();startBeat();
    }else await auth.signInWithEmailAndPassword(EMAIL(name),pw);
    ["u","p","p2"].forEach(i=>$(i).value="");toast("Welcome, "+name+"!");
  }catch(e){console.error(e);err(AUTH_ERR[e.code]||("Something went wrong ("+(e.code||e.message||"unknown")+")."))}
  finally{signingUp=false;$("go").disabled=false}
}
$("go").onclick=submit;
["u","p","p2"].forEach(i=>$(i).addEventListener("keydown",e=>{if(e.key==="Enter")submit()}));
drawUser();drawPeople();initFirebase();

const PHONE_B64="";
const VR_B64="";
const GAMES={iphone:PHONE_B64,vr:VR_B64};
function openGame(k){
  const box=$("phone");
  const old=box.querySelector("iframe");if(old)old.remove();
  const bin=atob(GAMES[k]),arr=new Uint8Array(bin.length);
  for(let i=0;i<bin.length;i++)arr[i]=bin.charCodeAt(i);
  const f=document.createElement("iframe");f.title="RecSandbox";
  f.setAttribute("allow","xr-spatial-tracking; fullscreen");
  f.srcdoc=new TextDecoder().decode(arr);box.appendChild(f);
  box.classList.add("on");document.body.style.overflow="hidden";
  try{history.replaceState(null,"","#"+k)}catch(e){}
}
function closeGame(){
  const box=$("phone"),f=box.querySelector("iframe");if(f)f.remove();
  box.classList.remove("on");document.body.style.overflow="";
  try{history.replaceState(null,"",location.pathname+location.search)}catch(e){}
}
$("playPhone").addEventListener("click",()=>openGame("iphone"));
$("playVR").addEventListener("click",()=>openGame("vr"));
$("phoneClose").addEventListener("click",closeGame);
if(location.hash==="#iphone")openGame("iphone");
if(location.hash==="#vr")openGame("vr");
</script>
